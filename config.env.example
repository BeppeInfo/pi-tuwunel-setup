# Copie para config.env e edite:
#   cp config.env.example config.env
# Não publique config.env (contém o token de registro).

# clearnet = DNS + Caddy + HTTPS (padrão)
# tor      = só Tor: onion vira SERVER_NAME, sem Caddy/DNS/portas 80/443
#            Não federação com matrix.org. Não apague /var/lib/tor/tuwunel.
NETWORK_MODE=clearnet

# Nome do servidor Matrix (MXID: @usuario:SERVER_NAME).
# Em NETWORK_MODE=tor deixe vazio: o script usa o .onion gerado.
SERVER_NAME=exemplo.com

# Hostname HTTPS do homeserver (CNAME talk → apex, em geral).
# Ignorado em NETWORK_MODE=tor.
MATRIX_HOST=talk.exemplo.com

# Token pedido na criação da conta no Element.
# Deixe vazio para o script gerar um aleatório.
REGISTRATION_TOKEN=

# true = contas novas com token; false = só quem já existe
ALLOW_REGISTRATION=true

ALLOW_FEDERATION=true

# Tuwunel só escuta em localhost (não exponha 6167 na WAN).
LISTEN_ADDR=127.0.0.1
LISTEN_PORT=6167

# Portas que o Caddy abre no Pi (encaminhe as mesmas no roteador).
# 80 + 443: Let's Encrypt HTTP-01 (padrão).
# Outras (ex. 8080 e 8443): ISP bloqueou 80/443; veja TLS_MODE.
EXTERNAL_HTTP_PORT=80
EXTERNAL_HTTPS_PORT=443

# acme     = certificado Let's Encrypt (HTTP-01 na EXTERNAL_HTTP_PORT;
#            os validadores da LE só falam com a porta 80 — se HTTP ≠ 80,
#            use internal ou configure DNS-01 à mão no Caddy).
# internal = CA local do Caddy (clientes vão reclamar; útil na LAN / porta alta).
TLS_MODE=acme

# Texto exibido ao abrir o endereço do servidor no navegador (só a raiz "/").
# Vazio = mensagem padrão do Tuwunel. Sem crase (`); {…} vira placeholder do Caddy.
ROOT_MESSAGE=

# Banco RocksDB (usuário tuwunel precisa gravar aqui)
DATABASE_PATH=/var/lib/tuwunel

# Tamanho máximo de pedido em bytes (~20 MiB)
MAX_REQUEST_SIZE=20000000

# 1 = ufw com SSH + EXTERNAL_HTTP_PORT + EXTERNAL_HTTPS_PORT
INSTALL_UFW=0

# 1 = unattended-upgrades
INSTALL_UNATTENDED_UPGRADES=1
